rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function authIds() {
      return request.auth.token.keys().hasAny(['email'])
        ? [request.auth.uid, request.auth.token.email.lower()]
        : [request.auth.uid];
    }

    function isIdentity(value) {
      return signedIn() && value is string && value in authIds();
    }

    function isCallCaller(call) {
      return isIdentity(call.callerId);
    }

    function isCallMember(call) {
      return signedIn() && (
        isCallCaller(call) ||
        call.calleeIds.hasAny(authIds())
      );
    }

    function validCallCreate(callId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'id', 'callerId', 'callerName', 'callerAvatarUrl', 'calleeIds',
          'type', 'status', 'isGroup', 'groupId', 'participantsByUser',
          'createdAtMillis', 'startedAtMillis', 'endedAtMillis'
        ]) &&
        data.keys().hasAll([
          'id', 'callerId', 'callerName', 'callerAvatarUrl', 'calleeIds',
          'type', 'status', 'isGroup', 'groupId', 'participantsByUser',
          'createdAtMillis', 'startedAtMillis', 'endedAtMillis'
        ]) &&
        data.id == callId &&
        isIdentity(data.callerId) &&
        data.callerId.size() <= 256 &&
        data.callerName is string && data.callerName.size() <= 100 &&
        (data.callerAvatarUrl == null ||
          (data.callerAvatarUrl is string && data.callerAvatarUrl.size() <= 2048)) &&
        data.calleeIds is list && data.calleeIds.size() > 0 && data.calleeIds.size() <= 50 &&
        data.calleeIds.toSet().size() == data.calleeIds.size() &&
        !data.calleeIds.hasAny([data.callerId]) &&
        data.type in ['audio', 'video'] &&
        data.status == 'ringing' &&
        data.isGroup is bool &&
        (data.groupId == null || data.groupId is string) &&
        data.participantsByUser is map &&
        data.participantsByUser.size() == data.calleeIds.size() + 1 &&
        data.participantsByUser.keys().size() == data.calleeIds.size() + 1 &&
        data.participantsByUser.keys().hasAll(data.calleeIds.concat([data.callerId])) &&
        data.participantsByUser[data.callerId] is map &&
        data.participantsByUser[data.callerId].userId == data.callerId &&
        data.participantsByUser[data.callerId].role == 'host' &&
        data.participantsByUser[data.callerId].status == 'connected' &&
        data.participantsByUser[data.callerId].joinedAtMillis is int &&
        data.createdAtMillis is int &&
        data.startedAtMillis == null && data.endedAtMillis == null;
    }

    function changedFields() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }


    function calleeAction() {
      return resource.data.calleeIds.hasAny(authIds());
    }

    function connectedGroupParticipant(call) {
      let participantKey = participantKeyFor(call.participantsByUser);
      let participant = call.participantsByUser.get(participantKey, null);
      return call.isGroup == true && call.status == 'active' &&
        participant is map && participant.userId == participantKey &&
        participant.status == 'connected';
    }

    function participantKeyFor(data) {
      return request.auth.token.keys().hasAny(['email']) &&
          data.keys().hasAny([request.auth.token.email.lower()])
        ? request.auth.token.email.lower()
        : request.auth.uid;
    }

    function ownParticipantTransition(fromStatus, toStatus, setJoinTime) {
      let oldMap = resource.data.participantsByUser;
      let newMap = request.resource.data.participantsByUser;
      let participantKey = participantKeyFor(oldMap);
      let oldParticipant = oldMap.get(participantKey, null);
      let newParticipant = newMap.get(participantKey, null);
      let changedParticipantKeys = oldMap.diff(newMap).affectedKeys();
      return oldMap is map && newMap is map &&
        changedParticipantKeys.size() == 1 &&
        changedParticipantKeys.hasAny([participantKey]) &&
        oldParticipant is map && newParticipant is map &&
        oldParticipant.userId == participantKey &&
        newParticipant.userId == participantKey &&
        oldParticipant.status == fromStatus &&
        newParticipant.status == toStatus &&
        oldParticipant.diff(newParticipant).affectedKeys().hasOnly(
          setJoinTime ? ['status', 'joinedAtMillis'] : ['status']
        ) &&
        (setJoinTime
          ? newParticipant.joinedAtMillis is int
          : newParticipant.joinedAtMillis == oldParticipant.joinedAtMillis);
    }

    function validInviteParticipantChange() {
      let oldMap = resource.data.participantsByUser;
      let newMap = request.resource.data.participantsByUser;
      let inviteeId = request.resource.data.lastInvitedParticipantId;
      let oldParticipant = oldMap.get(inviteeId, null);
      let newParticipant = newMap.get(inviteeId, null);
      let changedParticipantKeys = oldMap.diff(newMap).affectedKeys();
      return inviteeId is string && inviteeId.size() > 0 && inviteeId.size() <= 256 &&
        request.resource.data.calleeIds.hasAny([inviteeId]) &&
        changedParticipantKeys.size() == 1 &&
        changedParticipantKeys.hasAny([inviteeId]) &&
        newParticipant is map &&
        newParticipant.userId == inviteeId &&
        newParticipant.displayName is string &&
        newParticipant.displayName.size() <= 100 &&
        (newParticipant.avatarUrl == null ||
          (newParticipant.avatarUrl is string && newParticipant.avatarUrl.size() <= 2048)) &&
        newParticipant.role == 'participant' &&
        newParticipant.status == 'ringing' &&
        newParticipant.joinedAtMillis == null &&
        (oldParticipant == null
          ? newParticipant.keys().hasOnly([
              'userId', 'displayName', 'avatarUrl', 'role', 'status', 'joinedAtMillis'
            ])
          : oldParticipant is map &&
            oldParticipant.userId == inviteeId &&
            oldParticipant.role == 'participant' &&
            oldParticipant.status in ['left', 'declined'] &&
            oldParticipant.diff(newParticipant).affectedKeys().hasOnly([
              'displayName', 'avatarUrl', 'status', 'joinedAtMillis'
            ]));
    }

    function acceptCall() {
      return calleeAction() &&
        resource.data.status == 'ringing' &&
        request.resource.data.status == 'active' &&
        request.resource.data.startedAtMillis is int &&
        (resource.data.startedAtMillis == null ||
          request.resource.data.startedAtMillis == resource.data.startedAtMillis) &&
        changedFields().hasOnly(['status', 'startedAtMillis', 'participantsByUser']) &&
        ownParticipantTransition('ringing', 'connected', true);
    }

    function acceptActiveGroupInvite() {
      return calleeAction() &&
        resource.data.status == 'active' &&
        request.resource.data.status == 'active' &&
        resource.data.isGroup == true &&
        request.resource.data.startedAtMillis == resource.data.startedAtMillis &&
        request.resource.data.calleeIds == resource.data.calleeIds &&
        changedFields().hasOnly(['participantsByUser']) &&
        ownParticipantTransition('ringing', 'connected', true);
    }

    function rejectCall() {
      return calleeAction() &&
        resource.data.status in ['ringing', 'active'] &&
        request.resource.data.status in [resource.data.status, 'rejected'] &&
        changedFields().hasOnly(['status', 'endedAtMillis', 'participantsByUser']) &&
        ownParticipantTransition('ringing', 'declined', false) &&
        (request.resource.data.status == 'rejected'
          ? !resource.data.isGroup && resource.data.calleeIds.size() == 1 &&
            request.resource.data.endedAtMillis is int
          : request.resource.data.endedAtMillis == resource.data.endedAtMillis);
    }

    function cancelCall() {
      return isCallCaller(resource.data) &&
        resource.data.status == 'ringing' &&
        request.resource.data.status == 'cancelled' &&
        request.resource.data.endedAtMillis is int &&
        changedFields().hasOnly(['status', 'endedAtMillis']);
    }

    function endCall() {
      return isCallMember(resource.data) &&
        resource.data.status in ['ringing', 'active'] &&
        request.resource.data.status == 'ended' &&
        request.resource.data.endedAtMillis is int &&
        changedFields().hasOnly(['status', 'endedAtMillis']);
    }

    function leaveCall() {
      return isCallMember(resource.data) &&
        resource.data.status in ['ringing', 'active'] &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.calleeIds is list &&
        (ownParticipantTransition('connected', 'left', false) ||
          ownParticipantTransition('ringing', 'left', false)) &&
        request.resource.data.calleeIds.toSet()
          .difference(resource.data.calleeIds.toSet()).size() == 0 &&
        (isCallCaller(resource.data)
          ? request.resource.data.calleeIds.toSet()
              .difference(resource.data.calleeIds.toSet()).size() == 0
          : resource.data.calleeIds.hasAny(authIds()) &&
            !request.resource.data.calleeIds.hasAny(authIds()) &&
            resource.data.calleeIds.toSet()
              .difference(request.resource.data.calleeIds.toSet()).size() == 1) &&
        changedFields().hasOnly([
          'calleeIds', 'participantsByUser'
        ]) &&
        request.resource.data.endedAtMillis == resource.data.endedAtMillis;
    }

    function inviteParticipant() {
      return (isCallCaller(resource.data) ||
          connectedGroupParticipant(resource.data)) &&
        resource.data.isGroup == true &&
        resource.data.status in ['ringing', 'active'] &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.calleeIds is list &&
        request.resource.data.participantsByUser is map &&
        request.resource.data.calleeIds.size() <= 50 &&
        request.resource.data.calleeIds.toSet().size() ==
          request.resource.data.calleeIds.size() &&
        request.resource.data.calleeIds.toSet()
          .difference(resource.data.calleeIds.toSet()).size() <= 1 &&
        resource.data.calleeIds.toSet()
          .difference(request.resource.data.calleeIds.toSet()).size() == 0 &&
        changedFields().hasOnly([
          'calleeIds', 'participantsByUser', 'lastInvitedParticipantId'
        ]) &&
        validInviteParticipantChange();
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /tasks/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /tokens/{tokenId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /chats/{chatId} {
      allow read, write: if request.auth != null;

      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    match /workingGroups/{groupId} {
      allow read, write: if request.auth != null;

      match /participants/{participantId} {
        allow read, write: if request.auth != null;
      }

      match /tasks/{taskId} {
        allow read, write: if request.auth != null;
      }

      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    match /calls/{callId} {
      allow get, list: if isCallMember(resource.data);
      allow create: if signedIn() && !exists(/databases/$(database)/documents/calls/$(callId)) &&
        validCallCreate(callId);
      allow update: if acceptCall() || acceptActiveGroupInvite() || rejectCall() || cancelCall() || endCall() ||
        leaveCall() || inviteParticipant();
      allow delete: if false;
    }
  }
}

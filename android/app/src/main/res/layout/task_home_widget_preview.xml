<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
             android:layout_width="match_parent"
             android:layout_height="match_parent"
             android:background="@drawable/widget_preview_background">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

            <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Личные задачи"
                    android:textColor="#F5F5FA"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="4"
                    android:textColor="#A0A2B0"
                    android:textSize="14sp"/>

            <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/widget_preview_card"
                    android:contentDescription=""
                    android:padding="6dp"
                    android:src="@drawable/ic_widget_refresh"
                    android:tint="#BEC0CD"/>
        </LinearLayout>

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_preview_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="9dp">
                <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription=""
                        android:src="@drawable/ic_widget_task_alt"
                        android:tint="#FFC928"/>
                <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Подготовить проект     ☷ 1/2   ◷ 15 нояб."
                        android:textColor="#F5F5FA"
                        android:textSize="12sp"/>
            </LinearLayout>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_preview_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="9dp">
                <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription=""
                        android:src="@drawable/ic_widget_circle_outlined"
                        android:tint="#16A05A"/>
                <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Отправить отчёт          ◷ 20 нояб."
                        android:textColor="#F5F5FA"
                        android:textSize="12sp"/>
            </LinearLayout>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_preview_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="9dp">
                <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription=""
                        android:src="@drawable/ic_widget_task_alt"
                        android:tint="#F0444E"/>
                <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Проверить макет          ◷ 22 нояб."
                        android:textColor="#F5F5FA"
                        android:textSize="12sp"/>
            </LinearLayout>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_preview_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="9dp">
                <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription=""
                        android:src="@drawable/ic_widget_circle_outlined"
                        android:tint="#16A05A"/>
                <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Позвонить команде         ◷ 25 нояб."
                        android:textColor="#F5F5FA"
                        android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
